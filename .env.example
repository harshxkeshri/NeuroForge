# MandiMatch Environment Variables (Optional Demo Configuration)
# If Supabase is not provided, the application runs automatically in High-Fidelity Local Demo Mode.

# Server Port
PORT=5001

# Supabase (PostgreSQL) Config
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional AI Assistant Key (e.g. Gemini / OpenAI). If absent, MandiMatch uses built-in Kisan Mitra NLP engine.
GEMINI_API_KEY=
